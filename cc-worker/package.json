{
  "name": "cc-worker",
  "version": "1.0.0",
  "description": "Distributed Claude Code Worker Bot",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "build:binary": "node scripts/build.mjs",
    "build:binary:all": "node scripts/build.mjs --all"
  },
  "bin": "dist/index.js",
  "pkg": {
    "scripts": "dist/**/*.js",
    "assets": [],
    "targets": [
      "node18-macos-x64",
      "node18-macos-arm64",
      "node18-win-x64",
      "node18-linux-x64"
    ],
    "outputPath": "binaries"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^1.0.0",
    "chalk": "^5.3.0",
    "dotenv": "^16.4.5",
    "socket.io-client": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.27.2",
    "pkg": "^5.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
