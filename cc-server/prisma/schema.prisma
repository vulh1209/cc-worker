// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Worker {
  id          String       @id @default(cuid())
  name        String
  apiKey      String       @unique
  apiKeyHash  String       // Hashed version for security
  status      WorkerStatus @default(OFFLINE)
  os          String?
  hostname    String?
  ipAddress   String?
  lastSeen    DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tasks       Task[]

  // Orchestration fields
  isOrchestrator     Boolean @default(false)
  orchestratorConfig Json?   // Stores orchestrator-specific settings

  // Ownership
  ownerId    String?
  owner      User?         @relation("OwnedWorkers", fields: [ownerId], references: [id])
  sharedWith WorkerShare[]

  // GitHub repository assignments for PR review routing
  assignedRepos WorkerRepository[]

  @@index([status])
  @@index([lastSeen])
  @@index([isOrchestrator])
  @@index([ownerId])
}

model Task {
  id           String     @id @default(cuid())
  prompt       String     @db.Text
  status       TaskStatus @default(PENDING)
  priority     Int        @default(0) // Higher = more priority
  workerId     String?
  worker       Worker?    @relation(fields: [workerId], references: [id])
  result       String?    @db.Text
  errorMessage String?    @db.Text
  logs         TaskLog[]
  startedAt    DateTime?
  completedAt  DateTime?
  duration     Int?       // milliseconds
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Session continuity for follow-up conversations
  sessionId     String?   // Claude Code SDK session ID for resume
  parentTaskId  String?   // Reference to parent task in conversation chain
  parentTask    Task?     @relation("TaskChain", fields: [parentTaskId], references: [id])
  followUpTasks Task[]    @relation("TaskChain")

  // Orchestration fields
  taskType             TaskType @default(REGULAR)
  orchestratedByTaskId String?  // Reference to parent orchestration task
  orchestratedByTask   Task?    @relation("Orchestration", fields: [orchestratedByTaskId], references: [id])
  orchestratedSubtasks Task[]   @relation("Orchestration")
  orchestrationDepth   Int      @default(0) // Prevents infinite decomposition
  routingDecision      Json?    // Stores orchestrator's decision

  // GitHub PR Review relation
  prReview             GitHubPRReview?

  // Workflow execution relation
  workflowExecutionId  String?
  workflowExecution    WorkflowExecution? @relation("WorkflowTasks", fields: [workflowExecutionId], references: [id])
  workflowStepIndex    Int?               // Which step in the workflow this task represents

  @@index([status])
  @@index([workflowExecutionId])
  @@index([workerId])
  @@index([createdAt])
  @@index([priority, createdAt]) // For queue ordering
  @@index([parentTaskId])
  @@index([sessionId])
  @@index([taskType])
  @@index([orchestratedByTaskId])
}

model TaskLog {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type      LogType
  content   Json
  timestamp DateTime @default(now())

  @@index([taskId, timestamp])
}

enum WorkerStatus {
  ONLINE
  OFFLINE
  BUSY
}

enum TaskStatus {
  PENDING
  ORCHESTRATING  // Being analyzed by orchestrator
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum TaskType {
  REGULAR               // Normal tasks - go through orchestration
  ORCHESTRATION_ANALYSIS // Internal orchestrator analysis - never re-orchestrated
  SUBTASK               // Decomposed subtasks - skip orchestration
  PR_REVIEW             // GitHub PR review tasks
}

enum LogType {
  SYSTEM
  TEXT
  THINKING
  TOOL_USE
  TOOL_RESULT
  ERROR
}

// Phase 3: Task Templates
model TaskTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  prompt      String   @db.Text
  category    String?
  isPublic    Boolean  @default(true)
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isPublic])
}

// Multi-step Workflows (NightShift-inspired)
// Allows defining sequences of prompts with context preservation
model Workflow {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  steps       Json     // WorkflowStep[] - see types in shared package
  defaultModel String? // 'sonnet' | 'haiku' | 'opus'
  isActive    Boolean  @default(true)
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Ownership (optional)
  createdById String?
  createdBy   User?    @relation("CreatedWorkflows", fields: [createdById], references: [id])

  // Relations
  executions  WorkflowExecution[]

  @@index([name])
  @@index([isActive])
  @@index([createdById])
}

// Tracks individual workflow executions
model WorkflowExecution {
  id           String                  @id @default(cuid())
  workflowId   String
  workflow     Workflow                @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  status       WorkflowExecutionStatus @default(PENDING)
  currentStep  Int                     @default(0)
  totalSteps   Int
  stepResults  Json?                   // Results from completed steps
  variables    Json?                   // Template variables passed to workflow
  sessionId    String?                 // Claude session ID for context preservation
  startedAt    DateTime?
  completedAt  DateTime?
  errorMessage String?                 @db.Text
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  // Worker assignment
  workerId     String?

  // Tasks generated by this execution
  tasks        Task[]                  @relation("WorkflowTasks")

  @@index([workflowId])
  @@index([status])
  @@index([workerId])
}

enum WorkflowExecutionStatus {
  PENDING
  RUNNING
  PAUSED       // Waiting for human input
  COMPLETED
  FAILED
  CANCELLED
}

// Phase 3: User Authentication
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?   // Nullable for OAuth-only users
  role          UserRole  @default(USER)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // OAuth fields
  googleId      String?   @unique
  avatarUrl     String?

  // Relations
  sessions         Session[]
  ownedWorkers     Worker[]       @relation("OwnedWorkers")
  sharedWorkers    WorkerShare[]  @relation("SharedWorkers")
  createdWorkflows Workflow[]     @relation("CreatedWorkflows")

  @@index([email])
  @@index([role])
  @@index([googleId])
}

// Persistent sessions (replaces in-memory)
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ipAddress String?

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}

// Worker sharing
model WorkerShare {
  id        String   @id @default(cuid())
  workerId  String
  worker    Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("SharedWorkers", fields: [userId], references: [id], onDelete: Cascade)
  sharedAt  DateTime @default(now())
  sharedBy  String   // ID of user who shared

  @@unique([workerId, userId])
  @@index([workerId])
  @@index([userId])
}

enum UserRole {
  ADMIN
  USER
}

// Phase 3: Metrics
model TaskMetric {
  id              String   @id @default(cuid())
  date            DateTime @db.Date
  totalTasks      Int      @default(0)
  completedTasks  Int      @default(0)
  failedTasks     Int      @default(0)
  avgDuration     Int?     // milliseconds
  workerId        String?

  @@unique([date, workerId])
  @@index([date])
}

// ============================================================================
// GitHub Integration
// ============================================================================

// GitHub App installation tracking
model GitHubInstallation {
  id              String    @id @default(cuid())
  installationId  Int       @unique
  accountLogin    String    // org or user name
  accountType     String    // "User" | "Organization"
  accountId       Int
  accessToken     String?   @db.Text  // Cached installation access token (short-lived, ~1hr expiry)
  tokenExpiresAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  repositories    GitHubRepository[]

  @@index([accountLogin])
}

// Repository configuration for PR reviews
model GitHubRepository {
  id                String   @id @default(cuid())
  installationId    String
  installation      GitHubInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  repoId            Int      @unique
  owner             String
  name              String
  fullName          String   // "owner/name"
  autoReviewEnabled Boolean  @default(true)
  reviewOnMention   Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  reviews           GitHubPRReview[]
  assignedWorkers   WorkerRepository[]

  @@unique([owner, name])
  @@index([fullName])
  @@index([autoReviewEnabled])
}

// Worker ↔ Repository assignment (many-to-many)
// Each worker can be assigned to multiple repos
// Each repo can have multiple workers assigned
model WorkerRepository {
  id           String   @id @default(cuid())
  workerId     String
  worker       Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  repositoryId String
  repository   GitHubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  assignedAt   DateTime @default(now())
  assignedBy   String?  // User ID who made the assignment

  @@unique([workerId, repositoryId])
  @@index([workerId])
  @@index([repositoryId])
}

// Track PR reviews to avoid duplicates and enable re-reviews
model GitHubPRReview {
  id           String         @id @default(cuid())
  repositoryId String
  repository   GitHubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  prNumber     Int
  prTitle      String
  prAuthor     String
  headSha      String         // Commit SHA reviewed
  taskId       String?        @unique
  task         Task?          @relation(fields: [taskId], references: [id])
  status       PRReviewStatus @default(PENDING)
  commentId    BigInt?        // GitHub comment ID for updates
  triggeredBy  String         // "auto" | "mention:username"
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([repositoryId, prNumber, headSha])
  @@index([taskId])
  @@index([status])
}

enum PRReviewStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}
