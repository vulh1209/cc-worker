// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Worker {
  id          String       @id @default(cuid())
  name        String
  apiKey      String       @unique
  apiKeyHash  String       // Hashed version for security
  status      WorkerStatus @default(OFFLINE)
  os          String?
  hostname    String?
  ipAddress   String?
  lastSeen    DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tasks       Task[]

  // Orchestration fields
  isOrchestrator     Boolean @default(false)
  orchestratorConfig Json?   // Stores orchestrator-specific settings

  // Ownership
  ownerId    String?
  owner      User?         @relation("OwnedWorkers", fields: [ownerId], references: [id])
  sharedWith WorkerShare[]

  @@index([status])
  @@index([lastSeen])
  @@index([isOrchestrator])
  @@index([ownerId])
}

model Task {
  id           String     @id @default(cuid())
  prompt       String     @db.Text
  status       TaskStatus @default(PENDING)
  priority     Int        @default(0) // Higher = more priority
  workerId     String?
  worker       Worker?    @relation(fields: [workerId], references: [id])
  result       String?    @db.Text
  errorMessage String?    @db.Text
  logs         TaskLog[]
  startedAt    DateTime?
  completedAt  DateTime?
  duration     Int?       // milliseconds
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Session continuity for follow-up conversations
  sessionId     String?   // Claude Code SDK session ID for resume
  parentTaskId  String?   // Reference to parent task in conversation chain
  parentTask    Task?     @relation("TaskChain", fields: [parentTaskId], references: [id])
  followUpTasks Task[]    @relation("TaskChain")

  // Orchestration fields
  taskType             TaskType @default(REGULAR)
  orchestratedByTaskId String?  // Reference to parent orchestration task
  orchestratedByTask   Task?    @relation("Orchestration", fields: [orchestratedByTaskId], references: [id])
  orchestratedSubtasks Task[]   @relation("Orchestration")
  orchestrationDepth   Int      @default(0) // Prevents infinite decomposition
  routingDecision      Json?    // Stores orchestrator's decision

  @@index([status])
  @@index([workerId])
  @@index([createdAt])
  @@index([priority, createdAt]) // For queue ordering
  @@index([parentTaskId])
  @@index([sessionId])
  @@index([taskType])
  @@index([orchestratedByTaskId])
}

model TaskLog {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type      LogType
  content   Json
  timestamp DateTime @default(now())

  @@index([taskId, timestamp])
}

enum WorkerStatus {
  ONLINE
  OFFLINE
  BUSY
}

enum TaskStatus {
  PENDING
  ORCHESTRATING  // Being analyzed by orchestrator
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum TaskType {
  REGULAR               // Normal tasks - go through orchestration
  ORCHESTRATION_ANALYSIS // Internal orchestrator analysis - never re-orchestrated
  SUBTASK               // Decomposed subtasks - skip orchestration
}

enum LogType {
  SYSTEM
  TEXT
  THINKING
  TOOL_USE
  TOOL_RESULT
  ERROR
}

// Phase 3: Task Templates
model TaskTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  prompt      String   @db.Text
  category    String?
  isPublic    Boolean  @default(true)
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isPublic])
}

// Phase 3: User Authentication
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?   // Nullable for OAuth-only users
  role          UserRole  @default(USER)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // OAuth fields
  googleId      String?   @unique
  avatarUrl     String?

  // Relations
  sessions      Session[]
  ownedWorkers  Worker[]       @relation("OwnedWorkers")
  sharedWorkers WorkerShare[]  @relation("SharedWorkers")

  @@index([email])
  @@index([role])
  @@index([googleId])
}

// Persistent sessions (replaces in-memory)
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ipAddress String?

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}

// Worker sharing
model WorkerShare {
  id        String   @id @default(cuid())
  workerId  String
  worker    Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("SharedWorkers", fields: [userId], references: [id], onDelete: Cascade)
  sharedAt  DateTime @default(now())
  sharedBy  String   // ID of user who shared

  @@unique([workerId, userId])
  @@index([workerId])
  @@index([userId])
}

enum UserRole {
  ADMIN
  USER
}

// Phase 3: Metrics
model TaskMetric {
  id              String   @id @default(cuid())
  date            DateTime @db.Date
  totalTasks      Int      @default(0)
  completedTasks  Int      @default(0)
  failedTasks     Int      @default(0)
  avgDuration     Int?     // milliseconds
  workerId        String?

  @@unique([date, workerId])
  @@index([date])
}
