# Database
DATABASE_URL="postgresql://user:password@localhost:5432/cc_worker?schema=public"

# Server
PORT=3000
NODE_ENV=development

# Google OAuth (optional - for Google login)
# Get credentials from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:3000

# Email whitelist (comma-separated list of allowed emails)
# Only these emails can login. Leave empty to allow all.
ALLOWED_EMAILS=admin@example.com,user@example.com

# Optional
LOG_LEVEL=info

# ============================================================================
# GitHub App Configuration (for PR Review feature)
# ============================================================================
# Create a GitHub App at https://github.com/settings/apps/new
# Required permissions: Pull requests (read & write), Issues (read & write)
# Webhook events: Pull request, Issue comment, Installation

# GitHub App ID (found on app settings page)
GITHUB_APP_ID=

# GitHub App Private Key (generate and download from app settings)
# Can be the full key or path to .pem file
# For multi-line keys, use \n for newlines
GITHUB_APP_PRIVATE_KEY=

# Webhook secret (set when creating the app)
GITHUB_WEBHOOK_SECRET=

# Bot username (the app's name as shown on GitHub, e.g., "my-pr-bot[bot]")
GITHUB_BOT_USERNAME=cc-worker-bot
